# ==========================================
# DATI (Esclusione file locali pesanti)
# ==========================================
# Ignora tutti i file dentro la cartella data/
data/*

# Ma non ignorare il file .gitkeep (permette di mantenere la cartella vuota su Git)
!data/.gitkeep

# Escludi file di dati comuni nel caso finissero fuori dalla cartella data/
*.csv
*.xlsx
*.xls
*.json
*.parquet
